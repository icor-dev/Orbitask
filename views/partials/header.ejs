<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> · Orbitask</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="barra">
    <a class="logo" href="/">🪐 Orbitask</a>
    <nav>
      <% if (usuario) { %>
        <span class="usuario"><%= usuario.email %> · <%= usuario.rol %></span>
        <form action="/logout" method="POST" class="inline"><button class="enlace">Salir</button></form>
      <% } else { %>
        <a href="/login">Iniciar sesión</a>
        <a href="/registro">Crear cuenta</a>
      <% } %>
    </nav>
  </header>
  <main class="contenedor">
    <% if (flash) { %>
      <div class="alerta <%= flash.tipo %>"><%= flash.texto %></div>
    <% } %>
